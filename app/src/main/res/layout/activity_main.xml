<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0f172a"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛡️ حماية أحمد الشاعر"
        android:textColor="#3b82f6"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="جاري الاتصال بالسيرفر..."
        android:textColor="#ef4444"
        android:textSize="16sp"
        android:layout_marginBottom="30dp"/>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchCamera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔒 حماية الكاميرا (قفل تام)"
        android:textColor="#ffffff"
        android:textSize="18sp"
        android:padding="10dp"/>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchApps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔒 حماية التطبيقات (المعرض والملفات)"
        android:textColor="#ffffff"
        android:textSize="18sp"
        android:padding="10dp"/>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchNotifications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔒 حماية الإشعارات (منع الوصول)"
        android:textColor="#ffffff"
        android:textSize="18sp"
        android:padding="10dp"/>

    <Button
        android:id="@+id/btnAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="تفعيل صلاحيات الحماية (Admin)"
        android:layout_marginTop="30dp"
        android:backgroundTint="#3b82f6"/>

</LinearLayout>
